    <entry>
      <name>SQL_dim_pacient</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE OR REPLACE VIEW dim_pacient AS
SELECT DISTINCT
	"vital.status",
	"PR.Status",
	"ER.Status",
	"HER2.Final.Status",
	"histological.type"
FROM tb_brca_data;</sql>
